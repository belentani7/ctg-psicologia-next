{
  "name": "ctg-psicologia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node -e \"require('fs').cpSync('.next/static','.next/standalone/.next/static',{recursive:true}); if(require('fs').existsSync('public')) require('fs').cpSync('public','.next/standalone/public',{recursive:true});\"",
    "start": "node .next/standalone/server.js",
    "lint": "node scripts/lint.mjs",
    "check": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.1",
    "autoprefixer": "^10.4.20"
  }
}
