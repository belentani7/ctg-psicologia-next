{
  "name": "ctg-psicologia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test",
    "catalog": "node scripts/build-catalog.mjs",
    "catalog:check": "node scripts/validate-catalog.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
