{
  "$comment": "Fuente única de verdad de la paleta. La consumen tailwind.config.ts, data/catalogo.json y los tests de contraste (WCAG 2.2 AA).",
  "brand": {
    "teal": "#0f766e",
    "soft": "#f0fdfa",
    "deep": "#134e4a",
    "amber": "#b45309"
  },
  "surface": {
    "bg": "#f7f4ef",
    "ink": "#221f1a",
    "muted": "#475569"
  },
  "contrastPairs": [
    { "foreground": "surface.ink", "background": "surface.bg", "min": 4.5 },
    { "foreground": "#ffffff", "background": "brand.teal", "min": 4.5 },
    { "foreground": "#ffffff", "background": "brand.amber", "min": 4.5 },
    { "foreground": "#ffffff", "background": "brand.deep", "min": 4.5 },
    { "foreground": "brand.teal", "background": "brand.soft", "min": 4.5 },
    { "foreground": "surface.muted", "background": "#ffffff", "min": 4.5 }
  ]
}
